<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Projet       : Mouchkilti - Signalement de problèmes urbains
  Fichier      : activity_liste_signalements.xml 
  Description  : Interface graphique de la liste des signalements
  Responsable(s) : 
    - Souhail BECHCHARI
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grey_light">

    <TextView
        android:id="@+id/tvWelcomeUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:textColor="@color/white"
        android:padding="12dp"
        android:text="Bienvenue, Citoyen"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnGoCarte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Carte des Incidents"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnAjouter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+ Nouveau Signalement"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvSignalements"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/grey_light"
        android:dividerHeight="6dp"
        android:padding="8dp" />

</LinearLayout>
